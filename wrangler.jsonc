{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "my-svelte-app",
	"main": ".svelte-kit/cloudflare/_worker.js",
	"compatibility_date": "2025-03-03",
	"observability": {
		"enabled": true
	},
	"site": {
		"bucket": ".svelte-kit/cloudflare"
	},
	"routes": [
		{
			"pattern": "yourdomainname.com",
			"custom_domain": true
		},
		{
			"pattern": "www.yourdomainname.com",
			"custom_domain": true
		}
	],
	"preview_urls": true,
	"workers_dev": true
}
